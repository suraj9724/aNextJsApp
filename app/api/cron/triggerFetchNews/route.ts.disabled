import { NextResponse } from 'next/server';
import fetchAndStoreNews from '../fetchNewsCron';

export async function GET() {
  try {
    await fetchAndStoreNews();
    return NextResponse.json({ message: 'News fetch triggered successfully' });
  } catch (error) {
    console.error('Error triggering news fetch:', error);
    return NextResponse.json({ message: 'Error triggering news fetch', error: (error as any).message || String(error) }, { status: 500 });
  }
}
